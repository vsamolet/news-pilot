---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import RelatedArticles from '../../components/RelatedArticles.astro';
import { categoryLabel } from '../../lib/categories';

export async function getStaticPaths() {
  const entries = await getCollection('news');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { title, lead, pubDate, category, image, image_credit, image_credit_url, source_url } = entry.data;
const { Content } = await render(entry);

const allNews = (await getCollection('news')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const related = allNews
  .filter((e) => e.id !== entry.id && e.data.category === category)
  .slice(0, 3);

const label = categoryLabel(category);
const canonicalURL = new URL(`/news/${entry.id}/`, Astro.site).toString();
const imageURL = new URL(image, Astro.site).toString();
const logoURL = new URL('/logo.svg', Astro.site).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: title,
  description: lead,
  image: [imageURL],
  datePublished: pubDate.toISOString(),
  dateModified: pubDate.toISOString(),
  articleSection: label,
  inLanguage: 'ru',
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalURL,
  },
  author: {
    '@type': 'Organization',
    name: 'Деловой Вестник',
    url: String(Astro.site),
  },
  publisher: {
    '@type': 'Organization',
    name: 'Деловой Вестник',
    logo: {
      '@type': 'ImageObject',
      url: logoURL,
      width: 600,
      height: 120,
    },
  },
  ...(source_url ? { isBasedOn: source_url } : {}),
};

const dateLabel = pubDate.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });
const timeLabel = pubDate.toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' });

// Расчётное время чтения — по числу слов в исходном markdown-тексте статьи.
const wordCount = entry.body?.trim().split(/\s+/).filter(Boolean).length ?? 0;
const readingMinutes = Math.max(1, Math.round(wordCount / 200));

const isPhoto = image.endsWith('.webp') || image.endsWith('.jpg') || image.endsWith('.jpeg');

let sourceHostname = '';
try {
  sourceHostname = new URL(source_url).hostname.replace(/^www\./, '');
} catch {
  sourceHostname = '';
}
---

<Layout title={title} description={lead} image={image} jsonLd={jsonLd}>
  <div class="max-w-3xl mx-auto px-4 py-10">
    <p class="flex flex-wrap items-center gap-x-1.5 text-xs uppercase tracking-wide text-muted mb-6">
      <a href="/" class="hover:text-accent">Главная</a>
      <span>/</span>
      <a href={`/${category}/`} class="hover:text-accent">{label}</a>
      <span>/</span>
      <span class="text-ink/60 normal-case tracking-normal truncate max-w-[16rem]">{title}</span>
    </p>

    <article>
      <div class="text-xs uppercase tracking-wide font-semibold text-accent mb-3">{label}</div>
      <h1 class="font-serif text-3xl md:text-4xl font-bold leading-tight">{title}</h1>
      <p class="mt-4 text-lg md:text-xl font-serif text-ink/70 leading-relaxed">{lead}</p>

      <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-muted border-y border-hairline py-3">
        <span>{dateLabel}, {timeLabel}</span>
        <span class="text-hairline">&middot;</span>
        <span>{readingMinutes} мин чтения</span>
        {sourceHostname && (
          <>
            <span class="text-hairline">&middot;</span>
            <span>Источник: {sourceHostname}</span>
          </>
        )}
      </div>

      <figure class="mt-8">
        <img src={image} alt={title} class="w-full aspect-[16/9] object-cover bg-ink/5 border border-hairline" />
        {(image_credit || isPhoto) && (
          <figcaption class="mt-2 text-xs text-muted text-right">
            Фото:{' '}
            {image_credit ? (
              image_credit_url ? (
                <a href={image_credit_url} target="_blank" rel="noopener noreferrer" class="hover:text-accent underline underline-offset-2">{image_credit}</a>
              ) : (
                image_credit
              )
            ) : (
              'Unsplash'
            )}
            {' / '}
            <a href="https://unsplash.com" target="_blank" rel="noopener noreferrer" class="hover:text-accent underline underline-offset-2">Unsplash</a>
          </figcaption>
        )}
      </figure>

      <div class="prose-article max-w-none mt-6 text-base text-ink/90 leading-relaxed">
        <Content />
      </div>

      {source_url && (
        <p class="mt-8 text-sm text-muted">
          Первоисточник:{' '}
          <a href={source_url} target="_blank" rel="noopener noreferrer nofollow" class="text-accent hover:underline underline-offset-2">
            {sourceHostname || source_url}
          </a>
        </p>
      )}
    </article>

    <RelatedArticles entries={related} />
  </div>
</Layout>
