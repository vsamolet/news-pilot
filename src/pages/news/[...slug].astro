---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Sidebar from '../../components/Sidebar.astro';
import { categoryLabel } from '../../lib/categories';

export async function getStaticPaths() {
  const entries = await getCollection('news');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { title, lead, pubDate, category, image, source_url } = entry.data;
const { Content } = await render(entry);

const allNews = (await getCollection('news')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const sidebarItems = allNews.filter((e) => e.id !== entry.id).slice(0, 6);

const label = categoryLabel(category);
const canonicalURL = new URL(`/news/${entry.id}/`, Astro.site).toString();
const imageURL = new URL(image, Astro.site).toString();
const logoURL = new URL('/logo.svg', Astro.site).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: title,
  description: lead,
  image: [imageURL],
  datePublished: pubDate.toISOString(),
  dateModified: pubDate.toISOString(),
  articleSection: label,
  inLanguage: 'ru',
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalURL,
  },
  author: {
    '@type': 'Organization',
    name: 'Деловой Вестник',
    url: String(Astro.site),
  },
  publisher: {
    '@type': 'Organization',
    name: 'Деловой Вестник',
    logo: {
      '@type': 'ImageObject',
      url: logoURL,
      width: 600,
      height: 120,
    },
  },
  ...(source_url ? { isBasedOn: source_url } : {}),
};

const dateLabel = pubDate.toLocaleDateString('ru-RU', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
});
---

<Layout title={title} description={lead} image={image} jsonLd={jsonLd}>
  <div class="max-w-6xl mx-auto px-4 py-10">
    <p class="text-xs uppercase tracking-wide text-ink/50 mb-6">
      <a href="/" class="hover:text-accent">Главная</a> /
      <a href={`/${category}/`} class="hover:text-accent">{label}</a>
    </p>

    <div class="grid lg:grid-cols-3 gap-x-10 gap-y-12">
      <article class="lg:col-span-2">
        <div class="text-xs uppercase tracking-wide font-semibold text-accent mb-3">{label}</div>
        <h1 class="font-serif text-3xl md:text-4xl font-bold leading-tight">{title}</h1>
        <p class="mt-4 text-lg md:text-xl font-serif text-ink/80 leading-relaxed">{lead}</p>

        <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-ink/50 border-y border-hairline py-3">
          <time datetime={pubDate.toISOString()}>{dateLabel}</time>
          {source_url && (
            <>
              <span class="text-ink/30">&middot;</span>
              <a href={source_url} target="_blank" rel="noopener noreferrer nofollow" class="hover:text-accent underline underline-offset-2">
                Источник
              </a>
            </>
          )}
        </div>

        <figure class="mt-8">
          <img src={image} alt={title} class="w-full aspect-[16/9] object-cover bg-ink/5" />
        </figure>

        <div class="prose-article max-w-none mt-6 text-base text-ink/90">
          <Content />
        </div>
      </article>

      <Sidebar entries={sidebarItems} />
    </div>
  </div>
</Layout>
