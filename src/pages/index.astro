---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import AccentCard from '../components/AccentCard.astro';
import AnalyticsCard from '../components/AnalyticsCard.astro';
import Sidebar from '../components/Sidebar.astro';
import { categoryLabel } from '../lib/categories';

const allNews = (await getCollection('news')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Главная тема дня выбирается автоматически: приоритет — самая свежая
// новость из профильных деловых рубрик (рынки/экономика/компании) за
// последние 24 часа. Если за сутки в этих рубриках ничего не выходило —
// берём просто самый свежий материал сайта, в какой бы рубрике он ни был.
const HERO_PRIORITY_CATEGORIES = new Set(['markets', 'economics', 'business']);
const ONE_DAY_MS = 24 * 60 * 60 * 1000;
const now = Date.now();

const recentPriorityNews = allNews.filter(
  (e) => HERO_PRIORITY_CATEGORIES.has(e.data.category) && now - e.data.pubDate.valueOf() <= ONE_DAY_MS
); // allNews уже отсортирован по убыванию даты — порядок сохраняется после filter

const featured = recentPriorityNews[0] ?? allNews[0];

// Единый пул уже показанных статей — КАЖДЫЙ блок ниже, включая оба
// сайдбара, выбирает материалы только из того, что ещё не занято выше.
// Ни одна статья не должна появиться на главной дважды. Порядок отбора
// соответствует порядку блоков на странице по важности:
// Главная тема -> Акценты дня -> Контекст и тренды -> Главные новости ->
// Главное коротко -> Картина дня / Молнии.
const usedIds = new Set([featured.id]);

const accents = allNews.filter((e) => !usedIds.has(e.id)).slice(0, 3);
accents.forEach((e) => usedIds.add(e.id));

// Спецблок «Аналитика»: следующие материалы format:'analytics'. Если таких
// статей пока нет — секция просто не рендерится (см. условие ниже), без
// «дыры» на странице.
const analyticsItems = allNews.filter((e) => e.data.format === 'analytics' && !usedIds.has(e.id)).slice(0, 3);
analyticsItems.forEach((e) => usedIds.add(e.id));

const feedItems = allNews.filter((e) => !usedIds.has(e.id)).slice(0, 6);
feedItems.forEach((e) => usedIds.add(e.id));

// «Главное коротко»: только материалы format:'brief', ещё не занятые выше.
// Пока таких статей нет — секция скрывается целиком (см. условие в
// разметке ниже), без подмены дублем общей ленты.
const briefItems = allNews.filter((e) => e.data.format === 'brief' && !usedIds.has(e.id)).slice(0, 5);
briefItems.forEach((e) => usedIds.add(e.id));

// «Картина дня / Молнии»: хронологический тикер из того, что осталось —
// не пересекается ни с одним блоком выше на странице.
const tickerItems = allNews.filter((e) => !usedIds.has(e.id)).slice(0, 10);

const featuredDate = featured.data.pubDate.toLocaleDateString('ru-RU', {
  day: 'numeric',
  month: 'long',
  hour: '2-digit',
  minute: '2-digit',
});
---

<Layout title="Рынки и Компании">
  <div class="max-w-6xl mx-auto px-4 py-10">
    <!-- Первый экран: главная новость + акценты дня -->
    <section class="grid lg:grid-cols-5 gap-10 pb-10 mb-10 border-b border-hairline">
      <div class="lg:col-span-3">
        <a href={`/news/${featured.id}/`} class="block border border-hairline aspect-[16/9] overflow-hidden bg-ink/5">
          <img
            src={featured.data.image}
            alt={featured.data.title}
            class="w-full h-full object-cover"
          />
        </a>
        <div class="mt-5">
          <div class="text-xs uppercase tracking-wide font-semibold text-accent mb-3">
            {categoryLabel(featured.data.category)} &middot; Главная тема
          </div>
          <a href={`/news/${featured.id}/`}>
            <h1 class="font-serif text-3xl md:text-4xl font-bold leading-tight hover:text-accent transition-colors">
              {featured.data.title}
            </h1>
          </a>
          <p class="mt-4 text-lg text-ink/75 leading-relaxed">{featured.data.lead}</p>
          <time datetime={featured.data.pubDate.toISOString()} class="mt-4 block text-sm text-muted">
            {featuredDate}
          </time>
        </div>
      </div>

      <div class="lg:col-span-2">
        <h2 class="font-serif text-lg font-bold border-b-2 border-ink pb-2 mb-5">Акценты дня</h2>
        <div class="space-y-5">
          {accents.map((entry) => <AccentCard entry={entry} />)}
        </div>
      </div>
    </section>

    <!-- Спецблок: Аналитика / Контекст и тренды -->
    {analyticsItems.length > 0 && (
      <section class="pb-10 mb-10 border-b border-hairline">
        <h2 class="font-serif text-xl font-bold border-b-2 border-ink pb-2 mb-6">Контекст и тренды</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-10">
          {analyticsItems.map((entry) => <AnalyticsCard entry={entry} />)}
        </div>
      </section>
    )}

    <!-- Второй экран: лента новостей + боковые колонки -->
    <div class="grid lg:grid-cols-3 gap-x-10 gap-y-12">
      <section class="lg:col-span-2">
        <h2 class="font-serif text-xl font-bold border-b-2 border-ink pb-2 mb-6">Главные новости</h2>
        <div class="grid sm:grid-cols-2 gap-x-8 gap-y-10">
          {feedItems.map((entry) => <ArticleCard entry={entry} />)}
        </div>
      </section>

      <div class="space-y-10 lg:sticky lg:top-6 lg:self-start">
        {briefItems.length > 0 && <Sidebar entries={briefItems} title="Главное коротко" />}
        <Sidebar entries={tickerItems} title="Картина дня / Молнии" />
      </div>
    </div>
  </div>
</Layout>
