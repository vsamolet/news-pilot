---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entries: CollectionEntry<'news'>[];
  title?: string;
}

const { entries, title = 'Картина дня' } = Astro.props;
---

<aside class="lg:sticky lg:top-6">
  <h2 class="font-serif text-lg font-bold border-b-2 border-ink pb-2 mb-1">{title}</h2>
  <ol>
    {entries.map((entry) => (
      <li class="border-b border-hairline last:border-0">
        <a href={`/news/${entry.id}/`} class="group flex gap-3 items-baseline py-3">
          <time
            datetime={entry.data.pubDate.toISOString()}
            class="shrink-0 font-mono text-xs text-muted tabular-nums"
          >
            {entry.data.pubDate.toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' })}
          </time>
          <span class="text-sm leading-snug group-hover:text-accent transition-colors">
            {entry.data.title}
          </span>
        </a>
      </li>
    ))}
  </ol>
</aside>
