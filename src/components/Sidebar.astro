---
import type { CollectionEntry } from 'astro:content';
import { categoryLabel } from '../lib/categories';

interface Props {
  entries: CollectionEntry<'news'>[];
  title?: string;
}

const { entries, title = 'Свежая лента' } = Astro.props;
---

<aside class="lg:sticky lg:top-6">
  <h2 class="font-serif text-lg font-bold border-b-2 border-ink pb-2 mb-4">{title}</h2>
  <ol class="space-y-4">
    {entries.map((entry, i) => (
      <li class="flex gap-3 pb-4 border-b border-hairline last:border-0 last:pb-0">
        <span class="font-serif text-2xl font-bold text-ink/20 leading-none w-6 shrink-0">{String(i + 1).padStart(2, '0')}</span>
        <a href={`/news/${entry.id}/`} class="group">
          <div class="text-xs uppercase tracking-wide text-accent font-semibold">
            {categoryLabel(entry.data.category)}
          </div>
          <h3 class="font-serif text-base font-bold leading-snug group-hover:text-accent transition-colors mt-0.5">
            {entry.data.title}
          </h3>
          <time datetime={entry.data.pubDate.toISOString()} class="text-xs text-ink/45">
            {entry.data.pubDate.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit' })}
          </time>
        </a>
      </li>
    ))}
  </ol>
</aside>
