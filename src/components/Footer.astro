---
import { CATEGORIES } from '../lib/categories';
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-ink bg-ink text-paper">
  <div class="max-w-6xl mx-auto px-4 py-10">
    <div class="flex flex-col md:flex-row md:justify-between gap-8">
      <div>
        <p class="font-serif text-2xl font-bold">Деловой Вестник</p>
        <p class="mt-2 text-sm text-paper/60 max-w-sm">
          Независимое деловое издание. Новости экономики, политики и финансовых рынков.
        </p>
      </div>
      <div>
        <p class="text-xs uppercase tracking-widest text-paper/50 mb-3">Рубрики</p>
        <ul class="space-y-1 text-sm">
          {Object.entries(CATEGORIES).map(([slug, label]) => (
            <li><a href={`/${slug}/`} class="hover:text-accent transition-colors">{label}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <p class="text-xs uppercase tracking-widest text-paper/50 mb-3">Подписка</p>
        <a href="/rss.xml" class="text-sm hover:text-accent transition-colors">RSS-лента (Дзен)</a>
      </div>
    </div>
    <div class="mt-10 pt-6 border-t border-paper/15 text-xs text-paper/50">
      &copy; {year} Деловой Вестник. Все права защищены.
    </div>
  </div>
</footer>
